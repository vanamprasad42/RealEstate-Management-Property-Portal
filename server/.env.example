NODE_ENV=production
NODE_ENV=production
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=https://your-frontend-domain.com

# Email configuration (Nodemailer SMTP)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="RealEstate Platform <noreply@yourdomain.com>"

# AI Assistant Configuration (Optional: Gemini, Groq, OpenRouter, OpenAI, or APInex)
# If no external API key is provided, the built-in HomeNest AI Engine handles all queries seamlessly.
# Set to true only when an external provider is configured and verified. The
# built-in assistant remains the reliable default.
AI_USE_EXTERNAL_LLM=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_API_KEY=
APINEX_MODEL=deepseek-v4-flash
